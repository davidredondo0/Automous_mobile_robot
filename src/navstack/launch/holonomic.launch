<launch>
  <arg name="enable_lidar_odom" default="false"/>

  <!-- Laser Scan Matcher (Optional - Heavy on CPU, disabled by default) -->
  <group if="$(arg enable_lidar_odom)">
    <node pkg="laser_scan_matcher" type="laser_scan_matcher_node" name="laser_scan_matcher_node" output="screen" launch-prefix="bash -c 'sleep 10; $0 $@' ">
        <param name="base_frame" value="base_footprint" />
        <param name="fixed_frame" value="odom" />
        <param name="use_imu" value="false" />
        <param name="use_odom" value="true" /> 
        <param name="use_vel" value="true" />
        <param name="max_iterations" value="5" />
        <param name="publish_tf" value="true" />
        <param name="publish_pose" value="true" />
        <param name="publish_pose_stamped" value="true"/>
        <param name="use_alpha_beta" value="true"/>
        <remap from="pose_with_covariance_stamped" to="lidar_odom"/>
    </node>
  </group>
  
  <!-- SLAM Gmapping (Heavily optimized for low-power SBC) -->
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <param name="map_update_interval" value="5.0"/>   <!-- Increased from 2.0 -->
    <param name="maxUrange" value="4.0"/>             <!-- Reduced from 5.0 -->
    <param name="sigma" value="0.15"/>                <!-- Increased from 0.1 -->
    <param name="kernelSize" value="1"/>
    <param name="lstep" value="0.2"/>                 <!-- Increased from 0.15 -->
    <param name="astep" value="0.2"/>                 <!-- Increased from 0.15 -->
    <param name="iterations" value="1"/>
    <param name="lsigma" value="0.15"/>               <!-- Increased from 0.1 -->
    <param name="ogain" value="2.0"/>                 <!-- Reduced from 3.0 -->
    <param name="lskip" value="2"/>                   <!-- Increased from 1 (skip more laser scans) -->
    <param name="srr" value="0.15"/>                  <!-- Increased from 0.1 -->
    <param name="srt" value="0.3"/>                   <!-- Increased from 0.2 -->
    <param name="str" value="0.15"/>                  <!-- Increased from 0.1 -->
    <param name="stt" value="0.3"/>                   <!-- Increased from 0.2 -->
    <param name="linearUpdate" value="1.0"/>          <!-- Increased from 0.5 (less frequent updates) -->
    <param name="angularUpdate" value="0.5"/>         <!-- Increased from 0.25 -->
    <param name="temporalUpdate" value="5.0"/>        <!-- Changed from -1.0 to 5 seconds -->
    <param name="resampleThreshold" value="0.5"/>
    <param name="particles" value="10"/>              <!-- Reduced from 20 -->
    <param name="xmin" value="-3.0"/>
    <param name="ymin" value="-3.0"/>
    <param name="xmax" value="3.0"/>
    <param name="ymax" value="3.0"/>
    <param name="delta" value="0.1"/>                 <!-- Increased from 0.05 (coarser grid) -->
    <param name="llsamplerange" value="0.025"/>       <!-- Increased from 0.01 -->
    <param name="llsamplestep" value="0.1"/>          <!-- Increased from 0.05 -->
    <param name="lasamplerange" value="0.1"/>         <!-- Increased from 0.05 -->
    <param name="lasamplestep" value="0.1"/>          <!-- Increased from 0.05 -->
  </node>

  <!-- Move Base -->
  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <rosparam file="$(find navstack)/config/costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find navstack)/config/costmap_common_params.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find navstack)/config/local_costmap_params.yaml" command="load" />
    <rosparam file="$(find navstack)/config/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find navstack)/config/dwa_local_planner_params_holo.yaml" command="load" />
  </node>

</launch>
